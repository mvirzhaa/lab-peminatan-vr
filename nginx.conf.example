# Konfigurasi Nginx untuk Galeri Virtual Lab Peminatan TI UIKA
# Domain: vr.ti.fts.uika-bogor.ac.id
# Letakkan di: /etc/nginx/sites-available/vr.ti.fts.uika-bogor.ac.id

server {
    listen 80;
    listen [::]:80;
    server_name vr.ti.fts.uika-bogor.ac.id;

    # Batas ukuran upload (Wajib untuk upload buku PDF s.d. 40 MB dan foto Hall of Fame)
    client_max_body_size 50M;

    # Nginx akan di-redirect ke HTTPS otomatis setelah certbot dijalankan
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # WebSocket support (Wajib untuk multi-user avatar, chat, dan WebRTC voice signaling)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
